<Window x:Class="CowMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cow Master | Yönetim Paneli" Height="850" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="SteelBlue"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="145"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="0 20 20 0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="SteelBlue"/>
                                <Setter Property="Width" Value="155"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="Gold"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="OrangeRed" Offset="0.0"/>
                <GradientStop Color="LightGray" Offset="0.5"/>
                <GradientStop Color="SteelBlue" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" CornerRadius="25" Background="#44FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
            <Grid Width="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,20,0,10">
                    <TextBlock x:Name="txtSaat" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                    <TextBlock x:Name="txtTarih" FontSize="11" Foreground="#EEE" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,5">
                    <Ellipse Width="65" Height="65" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="imgGFoto" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="txtAdSoyad" Text="HÜSEYİN YÜCE" HorizontalAlignment="Center" Margin="5,8,5,2" FontSize="13" FontWeight="Black" Foreground="White"/>
                    <Separator Margin="35,5" Background="White" Opacity="0.3"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Hidden">

                    <StackPanel Margin="0,5">

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Ozet_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Sürü Özet" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Hayvanlar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🐄" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Hayvanlarım" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="HayvanSatıs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🐄" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Hayvan Satışları" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Sut_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🥛" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Süt Yönetimi" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Gelir_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Gelir/Gider" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="rasyon_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌾" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Balya/Stok" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Musteri_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤/🏢/🥩" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Müşteri" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Personel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👨‍🌾" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Personel" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                       

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Width="165" Click="Veteriner_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💉" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Veteriner" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <UniformGrid Grid.Row="3" Columns="2" Margin="10,20" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource SmallIconButtonStyle}"
                                 Content="📝" FontSize="22" Background="#00C853" Click="notlarım_Click"/>
                    <RadioButton Style="{StaticResource SmallIconButtonStyle}"
                                 Content="📅" FontSize="22" Background="#2979FF" Click="haftalıkgörev_Click"/>
                    <RadioButton Style="{StaticResource SmallIconButtonStyle}"
                                 Content="🌱" FontSize="22" Background="#FF6D00" Click="tarla_Click"/>
                    <RadioButton Style="{StaticResource SmallIconButtonStyle}"
                                 Content="🚜" FontSize="22" Background="#AA00FF" Click="ekipman_Click"/>
                </UniformGrid>

                <StackPanel Grid.Row="4" Margin="0,5,0,15">
                    <RadioButton Style="{StaticResource MenuButtonStyle}" Click="Ayarlar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="17" Margin="0,0,10,0"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="17"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource MenuButtonStyle}" Click="BtnKapat_Click" Background="Red" >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="17" Margin="0,0,10,0"/>
                            <TextBlock Text="Çıkış" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="17"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="10,12,12,12" CornerRadius="25" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid>
                <Image Source="/Assets/inek.png" Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
               
                <ContentControl x:Name="SayfaIcerigi" x:FieldModifier="public"/>
            </Grid>
        </Border>
    </Grid>
</Window>