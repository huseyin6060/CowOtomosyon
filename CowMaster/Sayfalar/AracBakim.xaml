<UserControl x:Class="CowMaster.Sayfalar.AracBakim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:kısıtlamalar="clr-namespace:CowMaster.kısıtlamalar"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1300">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#22FFFFFF" CornerRadius="25" Padding="20" Margin="0,0,0,20" BorderBrush="#44FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Border Background="#44FFFFFF" Padding="15" CornerRadius="20">
                    <materialDesign:PackIcon Kind="Tractor" Width="35" Height="35" Foreground="White" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Araç ve Ekipman Yönetimi" FontSize="32" FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Bakım döngüleri ve teknik envanter takibi" FontSize="16" Foreground="#DDD"/>
                </StackPanel>


                <StackPanel HorizontalAlignment="Right">

                    <Border Background="#22FFFFFF"
                  Padding="15,8" Margin="550,15,0,0"
                  CornerRadius="12">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Database"
                                           Width="18"
                                           Height="18"
                                           Foreground="#4ADE80"
                                           Margin="0,0,8,0"/>

                            <TextBlock  x:Name="Aktif_Kullanıcı"  Text="Aktif Kullanıcı"
                             Foreground="White"
                             FontWeight="SemiBold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Grid.Column="0" Columns="3" Margin="0,0,10,25">
            <materialDesign:Card Margin="10" Background="#FF1E88E5" Foreground="White" UniformCornerRadius="25" Padding="25">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ViewGrid" Opacity="0.8" Width="25" Height="25"/>
                    <TextBlock Text="Toplam Ekipman" Opacity="0.9" Margin="0,8,0,0" FontSize="14"/>
                    <TextBlock x:Name="txtToplamEkipman" Text="0 Adet" FontSize="28" FontWeight="ExtraBold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="10" Background="#FFF4511E" Foreground="White" UniformCornerRadius="25" Padding="25">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle" Opacity="0.8" Width="25" Height="25"/>
                    <TextBlock Text="Yaklaşan Bakımlar" Opacity="0.9" Margin="0,8,0,0" FontSize="14"/>
                    <TextBlock x:Name="txtYaklasanBakim" Text="0 Araç" FontSize="28" FontWeight="ExtraBold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="10" Background="#FF43A047" Foreground="White" UniformCornerRadius="25" Padding="25">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CheckCircle" Opacity="0.8" Width="25" Height="25"/>
                    <TextBlock Text="Aktif Çalışanlar" Opacity="0.9" Margin="0,8,0,0" FontSize="14"/>
                    <TextBlock x:Name="txtAktifUnite" Text="0 Ünite" FontSize="28" FontWeight="ExtraBold"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>
        
       <materialDesign:Card Grid.Row="2" Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp3" UniformCornerRadius="25" Margin="10,0,10,10" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

               <Border Grid.Row="0" Background="SlateGray" CornerRadius="25,25,0,0" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TruckCheck" Foreground="#1A237E" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock Text="Araç ve Ekipman Listesi" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="Black" Margin="0,0,20,0"/>

                            <TextBox x:Name="txtEkipmanAra" Width="250" 
         materialDesign:HintAssist.Hint="Araç veya Ekipman Ara..." 
         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
         materialDesign:TextFieldAssist.TextFieldCornerRadius="15" 
         Background="White" 
         materialDesign:TextFieldAssist.HasClearButton="True"
         TextChanged="txtEkipmanAra_TextChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
        Style="{StaticResource MaterialDesignFlatMidBgButton}" 
        ToolTip="Listeyi Yenile"
        Click="btnEkipmanYenile_Click">
                                <materialDesign:PackIcon Kind="Autorenew" Width="24" Height="24"/>
                            </Button>
                    </Grid>
                </Border>

                <DataGrid x:Name="dgEkipmanlar" 
                  Grid.Row="1" 
                  Margin="10" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True" 
                  Background="Transparent" 
                  BorderThickness="0" 
                  GridLinesVisibility="None" 
                  RowHeight="60"
                  SelectionUnit="FullRow"  
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  SelectionChanged="dgEkipmanlar_SelectionChanged">

                    <DataGrid.Columns>
                     
                        <DataGridTextColumn Header="EKİPMAN / ARAÇ" Binding="{Binding ekipman_ad}" FontWeight="Bold" Width="2*"/>

                        
                        <DataGridTextColumn Header="MEVCUT SAAT" Binding="{Binding mevcut_saat, StringFormat={}{0} Sa}" Width="*"/>

                       
                        <DataGridTemplateColumn Header="BAKIM DURUMU" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="5">
                                        <TextBlock Text="{Binding kalan_saat, StringFormat={}{0} saat kaldı}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border CornerRadius="10" ClipToBounds="True" Background="#E2E8F0">
                                            <ProgressBar Value="{Binding bakim_yuzde}" Height="10" Foreground="{Binding durum_renk}" Background="Transparent" BorderThickness="0"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                       
                        <DataGridTemplateColumn Header="İŞLEM" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="btnBakimOnayla" 
                                    Style="{StaticResource MaterialDesignIconButton}" 
                                    Foreground="SeaGreen" 
                                    Click="BtnBakimOnayla_Click" 
                                    Width="35" Height="35">
                                        <materialDesign:PackIcon Kind="WrenchCheck" Width="22"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
        
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Background="White" CornerRadius="30" Padding="25" Margin="10,10,8,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.1" ShadowDepth="4"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="lblPanelBaslik" Text="Ekipman Kaydı" FontSize="24" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,25"/>

                    <ComboBox x:Name="cmbKategori" materialDesign:HintAssist.Hint="Ekipman Türü" Margin="0,0,0,15" Height="55"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="15">
                        <ComboBoxItem Content="Traktör"/>
                        <ComboBoxItem Content="Biçerdöver"/>
                        <ComboBoxItem Content="Süt Sağım Sistemi"/>
                        <ComboBoxItem Content="Yem Karma Makinesi"/>
                        <ComboBoxItem Content="Römork"/>
                    </ComboBox>

                    <TextBox x:Name="txtAracAd" materialDesign:HintAssist.Hint="Araç Marka / Model" Margin="0,0,0,15" Height="55"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="15"/>

                    <DatePicker x:Name="dpAlimTarihi" materialDesign:HintAssist.Hint="Satın Alma Tarihi" Margin="0,0,0,15" Height="55"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:TextFieldAssist.TextFieldCornerRadius="15"/>

                    <Separator Margin="0,5,0,20" Background="#F0F0F0"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtMevcutSaat" Grid.Column="0" materialDesign:HintAssist.Hint="Mevcut Saat" Height="55" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="15"/>
                        <TextBox x:Name="txtBakimPeriyodu" Grid.Column="2" materialDesign:HintAssist.Hint="Bakım (Saat)" Height="55" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="15"/>
                    </Grid>

                    
                    <Button  Click="BtnKaydet_Click" Height="55" Margin="0,0,0,10"
                            Background="#1565C0" BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="15">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircle" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ENVANTERE EKLE" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnGuncelle_Click" Height="50" Background="#EF6C00" 
                                BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="12">
                            <materialDesign:PackIcon Kind="Update"/>
                        </Button>
                        <Button  Grid.Column="2" Click="BtnSil_Click" Height="50" Background="#C62828" 
                                BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="12">
                            <materialDesign:PackIcon Kind="DeleteOutline"/>
                        </Button>
                    </Grid>

                    <Button  Click="BtnIptal_Click" Style="{StaticResource MaterialDesignFlatButton}" 
                            Height="45"  materialDesign:ButtonAssist.CornerRadius="15" Foreground="#7F8C8D" Content="Formu Temizle" Margin="3,10,3,0" Background="LightGray"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>