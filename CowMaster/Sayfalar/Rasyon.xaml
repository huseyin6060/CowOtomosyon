                                                     Height="22"
                                                     Margin="0,0,10,0"/>

                                    <TextBlock Text="STOK HAREKETİ KAYDET"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </GroupBox>

                  

                    <GroupBox Header="RASYON TANIMLARI"
                      Style="{StaticResource MaterialDesignCardGroupBox}"
