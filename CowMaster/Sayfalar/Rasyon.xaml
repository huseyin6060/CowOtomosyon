                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="FoodApple"
                                                     Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"/>

                                    <TextBlock Text="RASYON KAYDET"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </GroupBox>

                 

                    <GroupBox Header="RASYON İÇERİĞİ"
                      Style="{StaticResource MaterialDesignCardGroupBox}"
                      Margin="0,0,0,15"
                      Padding="15">

                        <StackPanel>

                          
                            <ComboBox x:Name="cbRasyonSec"
                              materialDesign:HintAssist.Hint="Rasyon Seç"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                              Height="55"
                              Margin="0,0,0,15"/>

                            
                            <ComboBox x:Name="cbRasyonStok"
                              materialDesign:HintAssist.Hint="Stok / Hammadde"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                              Height="55"
                              Margin="0,0,0,15"/>

                            
                            <TextBox x:Name="txtRasyonMiktar" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             materialDesign:HintAssist.Hint="Miktar"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             Height="55"
                             Margin="0,0,0,15"/>

                         
                            <Button 
                            Height="50"
                            Background="#EA580C"
                            Foreground="White"
                            BorderThickness="0"
                            materialDesign:ButtonAssist.CornerRadius="12"
