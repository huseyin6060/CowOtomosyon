                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             Height="55"
                             Margin="0,0,0,15"/>

                            <TextBox x:Name="txtHedefHayvan" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             materialDesign:HintAssist.Hint="Hedef Hayvan"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             Height="55"
                             Margin="0,0,0,15"/>

                            <TextBox x:Name="txtRasyonAciklama" kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                             materialDesign:HintAssist.Hint="Açıklama"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             Height="90"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,15"/>

                           
                            <Button 
                            Height="50"
                            Background="#7C3AED"
                            Foreground="White"
                            BorderThickness="0"
                            materialDesign:ButtonAssist.CornerRadius="12"
