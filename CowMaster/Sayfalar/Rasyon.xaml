                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="PlaylistPlus"
                                                     Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"/>

                                    <TextBlock Text="RASYON İÇERİĞİ EKLE"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </GroupBox>

                </StackPanel>

            </ScrollViewer>

        </Border>

