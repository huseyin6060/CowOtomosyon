<UserControl x:Class="CowMaster.Sayfalar.Hayvanlarım"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:kısıtlamalar="clr-namespace:CowMaster.kısıtlamalar"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="950"
             d:DesignWidth="1450">

    <Grid >

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    
        <Border Grid.ColumnSpan="2"
                Margin="15"
                Padding="25"
                CornerRadius="22"
                Background="#0F172A">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid>

                <StackPanel Orientation="Horizontal">

                    <Border Width="75"
                            Height="75"
                            Background="#1E293B"
                            CornerRadius="20">

                        <materialDesign:PackIcon Kind="Cow"
                                                 Width="42"
                                                 Height="42"
                                                 Foreground="#38BDF8"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="18,0,0,0">

                        <TextBlock Text="HAYVAN YÖNETİM PANELİ"
                                   FontSize="30"
                                   FontWeight="Black"
                                   Foreground="White"/>

                        <TextBlock Text="Küpe • Irk • Kilo • Ahır • Durum • Soy Takibi"
                                   FontSize="14"
                                   Foreground="#CBD5E1"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#1E293B"
                        Padding="16,10"
                        CornerRadius="12">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="DatabaseCheck"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#4ADE80"
                                                 Margin="0,0,8,0"/>

                        <TextBlock x:Name="Aktif_Kullanıcı" Text="Aktif Kullanıcı"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="15,0,10,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="145"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

    
            <UniformGrid Columns="5" >

           
                <Border Background="White"
                        CornerRadius="18"
                        Margin="5"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>

                        <materialDesign:PackIcon Kind="Cow" Width="34" Height="34" Foreground="#2563EB"/>

                        <TextBlock Text="Toplam Hayvan"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtToplamHayvan"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

              
                <Border Background="White"
                        CornerRadius="18"
                        Margin="5"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>

                        <materialDesign:PackIcon Kind="HeartPulse"
                                                 Width="34"
                                                 Height="34"
                                                 Foreground="#16A34A"/>

                        <TextBlock Text="Aktif"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtAktif"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

              
                <Border Background="White"
                        CornerRadius="18"
                        Margin="5"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>

                        <materialDesign:PackIcon Kind="ScaleBathroom"
                                                 Width="34"
                                                 Height="34"
                                                 Foreground="#D97706"/>

                        <TextBlock Text="Ortalama Kilo"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtOrtalamaKilo"
                                   Text="0 KG"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

                
                <Border Background="White"
                        CornerRadius="18"
                        Margin="5"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>

                        <materialDesign:PackIcon Kind="HospitalBox"
                                                 Width="34"
                                                 Height="34"
                                                 Foreground="#DC2626"/>

                        <TextBlock Text="Hasta"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtHasta"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

                <Border Background="White"
                        CornerRadius="18"
                        Margin="5"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>

                        <materialDesign:PackIcon Kind="Barn"
                                                 Width="34"
                                                 Height="34"
                                                 Foreground="#7C3AED"/>

                        <TextBlock Text="Ahır Sayısı"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtAhir"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

            </UniformGrid>


            <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp3" UniformCornerRadius="25" Margin="10,15,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="25,25,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cow" Foreground="#22C55E" VerticalAlignment="Center" Width="28" Height="28" Margin="5,0,10,0"/>
                                <TextBlock Text="Hayvan Listesi" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="White" Margin="10,0,20,0"/>

                                <TextBox x:Name="txtHayvanAra" Width="260" 
                             materialDesign:HintAssist.Hint="Küpe No veya İsim Ara..." 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="15" 
                             Background="White" 
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Height="40" Padding="10,5" TextChanged="txtHayvanAra_TextChanged"/>
                            </StackPanel>

                            <Button Grid.Column="1" Margin="0,0,20,0"
                        Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                        Foreground="White" Width="50" Height="40"
                        ToolTip="Listeyi Yenile" Click="btnyenile_Click">
                                <materialDesign:PackIcon Kind="Autorenew" Width="22" Height="22"/>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgHayvanlar" 
                  Grid.Row="1" 
                  Margin="10,5,10,10" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True" 
                  Background="Transparent" 
                  BorderThickness="0" 
                  GridLinesVisibility="None" 
                  RowHeight="55"
                  SelectionMode="Single" 
                  SelectionUnit="FullRow"  
                  SelectionChanged="dgHayvanlar_SelectionChanged"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="10,0,0,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KÜPE NO" Binding="{Binding kupe_no}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="ANNE NO" Binding="{Binding anne_Kno}" Width="140"/>
                            <DataGridTextColumn Header="BABA NO" Binding="{Binding baba_Kno}" Width="140"/>
                            <DataGridTextColumn Header="GİRİŞ TARİHİ"  Binding="{Binding giris_tarihi, StringFormat=\{0:dd.MM.yyyy\}}"    Width="120"/>
                            <DataGridTextColumn Header="HAYVAN ADI" Binding="{Binding hayvan_adi}" Width="150"/>
                            <DataGridTextColumn Header="IRK" Binding="{Binding irk}" Width="120"/>
                            <DataGridTextColumn Header="CİNSİYET" Binding="{Binding cinsiyet}" Width="100"/>
                            <DataGridTextColumn Header="GENÇLİK DURUMU" Binding="{Binding genclikdurumu}" Width="100"/>
                            <DataGridTextColumn Header="KİLO" Binding="{Binding kilo, StringFormat='{}{0:G29} kg'}" Width="100"/>
                            <DataGridTextColumn Header="AHIR" Binding="{Binding ahir_no}" Width="80"/>

                            <DataGridTemplateColumn Header="DURUM" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DCFCE7" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding durum}" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="İŞLEM" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                    Foreground="#EF4444" Width="30" Height="30" Click="Sil_Click">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

      
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,15,15"
                Background="White"
                CornerRadius="22"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <TextBlock Text="Hayvan Kayıt İşlemleri"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Yeni hayvan ekleme ve güncelleme ekranı"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,5,0,25"/>


                    <TextBox x:Name="txtKupeNo" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             Foreground="#111827"
                             materialDesign:HintAssist.Hint="Küpe No"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBox x:Name="txtHayvanAdi" kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             Foreground="#111827"
                             materialDesign:HintAssist.Hint="Hayvan Adı"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>


                    <TextBox x:Name="txtIrk" kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             Foreground="#111827"
                             materialDesign:HintAssist.Hint="Irk"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

               
                    <ComboBox x:Name="cbCinsiyet"
                              Height="50"
                              Margin="0,0,0,15"
                              materialDesign:HintAssist.Hint="Cinsiyet"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        <ComboBoxItem Content="Erkek"/>
                        <ComboBoxItem Content="Dişi"/>

                    </ComboBox>


                    <ComboBox x:Name="cbgenclikdurumu"
          Height="50"
          Margin="0,0,0,15"
          materialDesign:HintAssist.Hint="Gençlik Durumu"
          Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        <ComboBoxItem Content="Tosun"/>
                        <ComboBoxItem Content="Düve"/>
                        <ComboBoxItem Content="İnek"/>
                        <ComboBoxItem Content="Dana"/>
                        <ComboBoxItem Content="Buzağı"/>

                    </ComboBox>


                    <TextBox x:Name="txtKilo" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             materialDesign:HintAssist.Hint="Kilo"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBox x:Name="txtAnneno" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
            Height="50"
            Margin="0,0,0,15"
            Padding="10"
            materialDesign:HintAssist.Hint="Anne Küpe No"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"/>



                    <TextBox x:Name="txtBaba" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
            Height="50"
            Margin="0,0,0,15"
            Padding="10"
            materialDesign:HintAssist.Hint="Baba Küpe No eğer yoksa 0 koyun"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"/>


                    <TextBox x:Name="txtRenk" kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             materialDesign:HintAssist.Hint="Renk"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>


                    <TextBox x:Name="txtAhirNo" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             materialDesign:HintAssist.Hint="Ahır No"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                
                    <DatePicker x:Name="dtDogum"
            Height="50"
            Margin="0,0,0,15"
            Padding="10"
            materialDesign:HintAssist.Hint="Doğum Tarihi"
            materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                  
                    <DatePicker x:Name="dtGiris"
            Height="50"
            Margin="0,0,0,15"
            Padding="10"
            materialDesign:HintAssist.Hint="İşletmeye Giriş Tarihi"
            materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                    <ComboBox x:Name="cbDurum"
                              Height="50"
                              Margin="0,0,0,15"
                              materialDesign:HintAssist.Hint="Durum"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        <ComboBoxItem Content="Aktif"/>
                        <ComboBoxItem Content="Satıldı"/>
                        <ComboBoxItem Content="Kesim"/>
                        <ComboBoxItem Content="Öldü"/>
                        <ComboBoxItem Content="Hasta"/>
                        <ComboBoxItem Content="Karantina"/>

                    </ComboBox>


                    <TextBox x:Name="txtSatisFiyati" kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             Height="50"
                             Margin="0,0,0,15"
                             Padding="10"
                             materialDesign:HintAssist.Hint="Satış Fiyatı"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>


                    <TextBox x:Name="txtAciklama" kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,20"
                             Padding="10"
                             materialDesign:HintAssist.Hint="Açıklama"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <Button  Click="btnKaydet_Click_1"
                            Height="55"
                            Background="#16A34A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Margin="0,0,0,10">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="22"
                                                     Height="22"
                                                     Margin="0,0,10,0"/>

                            <TextBlock Text="HAYVANI KAYDET"/>

                        </StackPanel>

                    </Button>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="guncelel_Click"
                                Height="48"
                                Margin="0,0,5,0"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Content="GÜNCELLE"/>

                        <Button Grid.Column="1" Click="Temizle_Click_1"
                                Height="48"
                                Margin="5,0,0,0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Content="TEMİZLE"/>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>