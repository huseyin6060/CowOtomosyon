<UserControl x:Class="CowMaster.Sayfalar.SütBilgisi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:kısıtlamalar="clr-namespace:CowMaster.kısıtlamalar"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FontFamily="Segoe UI Semibold">

    <UserControl.Resources>

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="#2C3E50"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="20" CornerRadius="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Direction="0" ShadowDepth="4" Opacity="0.08"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Width="50" Height="50" CornerRadius="12" Background="#E8F5E9" Margin="0,0,15,0">
                            <materialDesign:PackIcon Kind="Cow" Foreground="#2E7D32" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Süt Kayıt Yönetimi" FontSize="22" FontWeight="Bold" Foreground="#1A237E"/>
                            <TextBlock Text="Tbl_SutKayit Veri Giriş Paneli" FontSize="12" Foreground="#90A4AE"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#ECEFF1" Height="1"/>
                </StackPanel>

               <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="Both" Margin="0,0,0,10">
                    <StackPanel Margin="2,5">

                        <DatePicker x:Name="dpSagimTarihi" 
                            Language="tr-TR" 
                            materialDesign:HintAssist.Hint="Sağım Tarihi" 
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Margin="0,0,0,15"
                            materialDesign:TextFieldAssist.TextFieldCornerRadius="12"/>

                       <ComboBox x:Name="cbHayvanSec" 
                          materialDesign:HintAssist.Hint="Sağımı Yapılan Hayvan" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="55" Margin="0,0,0,15"
                          materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                          DisplayMemberPath="hayvan_no" 
                          SelectedValuePath="hayvan_id"/>

                       <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtLitre" Grid.Column="0"  kısıtlamalar:InputKisitlayici.SadeceSayi="True"
                             materialDesign:HintAssist.Hint="Süt Miktarı (Litre)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             materialDesign:TextFieldAssist.SuffixText=" L"/>

                           <ComboBox x:Name="cbKalite" Grid.Column="2" 
                              materialDesign:HintAssist.Hint="Süt Kalitesi" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:TextFieldAssist.TextFieldCornerRadius="12">
                                <ComboBoxItem Content="Yüksek (A Sınıfı)"/>
                                <ComboBoxItem Content="Orta (B Sınıfı)"/>
                                <ComboBoxItem Content="Düşük (C Sınıfı)"/>
                                <ComboBoxItem Content="Hastalıklı / İmha"/>
                            </ComboBox>
                        </Grid>

                        <TextBox x:Name="txtAciklama"  kısıtlamalar:InputKisitlayici.SadeceMetin="True"
                         materialDesign:HintAssist.Hint="İşlem Açıklaması ve Notlar" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                         Height="120" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalContentAlignment="Top" 
                         Padding="16,12"/>
                    </StackPanel>
                </ScrollViewer>

               <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button  Click="btnKaydet_Click" Margin="0,0,0,12" Height="55"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#2E7D32" 
                    materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SÜT KAYDINI TAMAMLA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button Click="btnGuncelle_Click" Margin="0,0,6,0" Height="50"
                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1976D2" Foreground="#1976D2"
                        materialDesign:ButtonAssist.CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Güncelle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button  Click="btnSil_Click" Margin="6,0,0,0" Height="50"
                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#E53935" Foreground="#E53935"
                        materialDesign:ButtonAssist.CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kaydı Sil" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

              <Border Grid.Row="3" Margin="0,20,0,0" Background="#F5F5F5" CornerRadius="15" Padding="5">
                    <UniformGrid Columns="2">
                        <Button  Click="btnIsletmeSut_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#2E7D32"
                        Height="38">
                            <TextBlock Text="TOPLU ÜRETİM" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <Button  Click="btnBireySut_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#546E7A" 
                        Height="38">
                            <TextBlock Text="HAYVAN BAZLI TAKİP" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>


        <Grid Grid.Column="1" Margin="10,20,25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="280"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0"
                     Margin="0,0,0,20"
                     UniformCornerRadius="25"
                     Background="White">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BAŞLIK -->
                    <TextBlock Grid.Row="0"
                   Text="Üretim Performans Analizi"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A237E"
                   Margin="0,0,0,15"/>

                    <!-- GRAFİK -->
                    <Border Grid.Row="1"
                Background="#F8FAFC"
                CornerRadius="20"
                Padding="10">

                        <lvc:CartesianChart
                Series="{Binding GrafikSerileri}"
                LegendLocation="Right"
                Hoverable="True"
                DisableAnimations="False"
                Zoom="X"
                Background="Transparent">

                            <!-- X EKSEN -->
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Tarih"
                              Labels="{Binding EksenEtiketleri}"
                              FontSize="13"
                              Foreground="#475569"/>
                            </lvc:CartesianChart.AxisX>

                            <!-- Y EKSEN -->
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Litre"
                              MinValue="0"
                              FontSize="13"
                              Foreground="#475569"/>
                            </lvc:CartesianChart.AxisY>

                        </lvc:CartesianChart>

                    </Border>

                </Grid>

            </materialDesign:Card>


            <materialDesign:Card Grid.Row="1" 
                      Grid.RowSpan="2"
                      materialDesign:ElevationAssist.Elevation="Dp3" 
                      UniformCornerRadius="25" 
                      Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                   
                    <Border Grid.Row="0" Background="SlateGray" CornerRadius="25,25,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WaterPercent" Foreground="#1A237E" VerticalAlignment="Center" Width="26" Height="26" Margin="5,0,10,0"/>
                                <TextBlock Text="Kayıtlı Süt Verileri" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="Black" Margin="10,0,20,0"/>

                             
                                <TextBox x:Name="txtSutAra" Width="220" 
                             materialDesign:HintAssist.Hint="Tarih Ara..." 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="15" 
                             Background="White" 
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Height="40" Padding="10,5"/>
                            </StackPanel>

                            <Button  Click="btnSutYenile_Click" Grid.Column="1" 
                        Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                        Width="50" Height="40"
                        ToolTip="Listeyi Güncelle">
                                <materialDesign:PackIcon Kind="Autorenew" Width="22" Height="22"/>
                            </Button>
                        </Grid>
                    </Border>

                 
                    <DataGrid Grid.Row="1"
                  x:Name="dgSutKayitlari"
                  Margin="10,5,10,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="Transparent"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  RowHeight="55"
                  SelectionMode="Single"   
                  SelectionUnit="FullRow" 
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  SelectionChanged="dgSutKayitlari_SelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="10,0,0,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Height" Value="40"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                        
                            <DataGridTemplateColumn Header="İŞLEM TARİHİ" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Foreground="#1A237E" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding islem_tarihi, StringFormat='dd.MM.yyyy'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                          
                            <DataGridTextColumn Header="MİKTAR (LT)" Binding="{Binding miktar, StringFormat='{}{0:N1} Lt'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                          
                            <DataGridTextColumn Header="TOPLAM TUTAR" Binding="{Binding toplam_tutar, StringFormat='₺{0:N2}'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#166534"/>
                                       
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="İŞLEM" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="#EF4444"
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>