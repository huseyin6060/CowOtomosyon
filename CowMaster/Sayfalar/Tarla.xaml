<UserControl x:Class="CowMaster.Sayfalar.Tarla"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:kısıtlamalar="clr-namespace:CowMaster.kısıtlamalar"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CowMaster.Sayfalar" 
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             FontFamily="Segoe UI Semibold">

    <UserControl.Resources>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="md:HintAssist.IsFloating" Value="True"/>
            <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="md:HintAssist.IsFloating" Value="True"/>
            <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,30,0"/>
        </Style>

     
        <Style x:Key="BaseActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>

        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="#EF6C00"/>
            <Setter Property="BorderBrush" Value="#EF6C00"/>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
        </Style>
    </UserControl.Resources>

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

       
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0" Margin="20,20,10,10" CornerRadius="15" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <Grid Margin="10">
                    <local:ParselSorguView x:Name="parselSorguEkranı" ClipToBounds="True"/>
                </Grid>
            </Border>

            
            <Border Grid.Row="1" Margin="20,10,10,20" CornerRadius="15" Background="White">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <md:PackIcon Kind="FormatListBulleted" Foreground="#2E7D32" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Kayıtlı Arazilerim" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#37474F"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTarlalar" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0" 
                              RowHeight="45" FontSize="13" SelectionUnit="FullRow" SelectionMode="Single"
                              IsReadOnly="True"   
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                              SelectionChanged="dgTarlalar_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="🏠 Tarla Adı" Binding="{Binding TarlaAdi}" Width="*"/>
                            <DataGridTextColumn Header="🌾 Mahsul" Binding="{Binding Mahsul}" Width="*"/>
                            <DataGridTextColumn Header="📏 Alan (m²)" Binding="{Binding Alan, StringFormat='{}{0:G29}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

  
        <Border Grid.Column="1" Background="White" Margin="10,20,20,20" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

             
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="45" Height="45" CornerRadius="12" Background="#E8F5E9">
                            <md:PackIcon Kind="Tractor" Foreground="#2E7D32" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Arazi Yönetimi" FontSize="20" FontWeight="Black" Foreground="#263238"/>
                            <TextBlock Text="Tarla verilerini güncelleyin" FontSize="11" Foreground="#90A4AE"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,20,0,0" Background="#ECEFF1"/>
                </StackPanel>

               
                <Border Grid.Row="1" Background="#2E7D32" CornerRadius="12" Padding="20,15" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="SİSTEMDEKİ PARSEL ALANI" FontSize="10" Foreground="#A5D6A7" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <md:PackIcon Kind="LayersOutline" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblAlan" Text="0.00" FontSize="28" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text=" m²" FontSize="14" Foreground="White" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

              
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBox x:Name="txtTarlaAdi" kısıtlamalar:InputKisitlayici.SadeceMetin="True" md:HintAssist.Hint="Tarla Adı" Foreground="Black" FontWeight="Bold"/>
                        <TextBox x:Name="txtCizilenAlan" kısıtlamalar:InputKisitlayici.SadeceSayi="True" md:HintAssist.Hint="Çizilen Alan / Mesafe" md:TextFieldAssist.SuffixText=" m²" Foreground="#2E7D32" FontWeight="Bold"/>

                        <ComboBox x:Name="cbMahsul" md:HintAssist.Hint="Ekilmiş Mahsul">
                            <ComboBoxItem Content="Buğday"/>
                            <ComboBoxItem Content="Mısır"/>
                            <ComboBoxItem Content="Ayçiçeği"/>
                            <ComboBoxItem Content="Arpa"/>
                            <ComboBoxItem Content="Yonca"/>
                        </ComboBox>

                        <TextBox x:Name="txtSuGideri" kısıtlamalar:InputKisitlayici.SadeceSayi="True" md:HintAssist.Hint="Yıllık Su Gideri (₺)" md:TextFieldAssist.PrefixText="₺ "/>
                        <TextBox x:Name="txtBoru"  kısıtlamalar:InputKisitlayici.SadeceSayi="True" md:HintAssist.Hint="Kullanılan Boru Miktarı (Adet)" md:TextFieldAssist.SuffixText=" Adet"/>
                        <TextBox x:Name="txtSatis" kısıtlamalar:InputKisitlayici.SadeceSayi="True" md:HintAssist.Hint="Hedeflenen Satış Tutarı (₺)" md:TextFieldAssist.PrefixText="₺ "/>

                        <Border Background="#FFF9C4" CornerRadius="8" Padding="12" Margin="0,5,0,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AlertCircleOutline" Foreground="#FBC02D" VerticalAlignment="Center"/>
                                <TextBlock Text="Bilgiler otomatik maliyet hesabında kullanılır." FontSize="11" Margin="8,0,0,0" Foreground="#F57F17" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button Click="BtnEkle_Click" Style="{StaticResource SaveButton}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="PlusCircle" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="YENİ ARAZİ EKLE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="1"  Click="BtnTemizle_Click"  Background="LightGray"
                           Style="{StaticResource DeleteButton}" Margin="5,5,0,5">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Delete" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Temizle" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"  Click="BtnGuncelle_Click" 
                                Style="{StaticResource UpdateButton}" Margin="0,5,5,5">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Pencil" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="GÜNCELLE" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"  Click="BtnSil_Click" 
                                Style="{StaticResource DeleteButton}" Margin="5,5,0,5">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Delete" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="SİL" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                     
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>