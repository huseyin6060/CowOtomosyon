<UserControl x:Class="CowMaster.Sayfalar.SuruBilgi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             >
 

    <UserControl.Resources>
       
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="-90" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

      
        <Style x:Key="HeaderBar" TargetType="Border">
            <Setter Property="Background" Value="#E2E8E7"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="85"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="15" Padding="15,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Cow" Foreground="#2E7D32" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Toplam Hayvan:" VerticalAlignment="Center" Foreground="#546E7A"/>
                        <TextBlock x:Name="txtToplamHayvan" Text=" 192" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center" Foreground="#2E7D32" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="15" Padding="15,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Work" Foreground="#1976D2" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="İşletme:" VerticalAlignment="Center" Foreground="#546E7A"/>
                        <TextBlock x:Name="txtIsletmeSayisi" Text=" 3" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1976D2" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="15" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FileChart" Foreground="#F57C00" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtRaporSayisi" Text="12 Rapor Hazır" FontWeight="Bold" VerticalAlignment="Center" Foreground="#F57C00"/>
                    </StackPanel>
                </Border>
            </StackPanel>

         
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#FEE2E2" CornerRadius="15" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="BellBadge" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtBildirimSayisi" Text="1 Yeni" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E293B" CornerRadius="15" Padding="15,8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="UserCircle" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Aktif_kullancı" Text="Aktif Kullanıcı" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <md:PackIcon Kind="ChevronDown" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <UniformGrid Columns="2">

              
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <md:PackIcon Kind="Counter" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6"/>
                                <TextBlock Text="Sürü Dağılımı" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#37474F"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="85"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Columns="5" Margin="0,0,0,10">
                             
                                <Border Background="#FFF1F2" CornerRadius="15" Margin="4" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="Cow" HorizontalAlignment="Center" Width="24" Height="24" Foreground="#E11D48"/>
                                        <TextBlock Text="İnek" HorizontalAlignment="Center" FontSize="11" Foreground="#9F1239" Margin="0,4"/>
                                        <TextBlock x:Name="txtInekAdet" Text="0" FontSize="18" Foreground="#E11D48" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F5F3FF" CornerRadius="15" Margin="4" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="Cow" HorizontalAlignment="Center" Width="24" Height="24" Foreground="#7C3AED"/>
                                        <TextBlock Text="Düve" HorizontalAlignment="Center" FontSize="11" Foreground="#5B21B6" Margin="0,4"/>
                                        <TextBlock x:Name="txtDuveAdet" Text="0" FontSize="18" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDFA" CornerRadius="15" Margin="4" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="Cow" HorizontalAlignment="Center" Width="24" Height="24" Foreground="#0D9488"/>
                                        <TextBlock Text="Tosun" HorizontalAlignment="Center" FontSize="11" Foreground="#115E59" Margin="0,4"/>
                                        <TextBlock x:Name="txtTosunAdet" Text="0" FontSize="18" Foreground="#0D9488" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="15" Margin="4" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="Cow" HorizontalAlignment="Center" Width="24" Height="24" Foreground="#2563EB"/>
                                        <TextBlock Text="Dana" HorizontalAlignment="Center" FontSize="11" Foreground="#1E40AF" Margin="0,4"/>
                                        <TextBlock x:Name="txtDanaAdet" Text="0" FontSize="18" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FDF2F8" CornerRadius="15" Margin="4" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="Cow" HorizontalAlignment="Center" Width="24" Height="24" Foreground="#DB2777"/>
                                        <TextBlock Text="Buzağı" HorizontalAlignment="Center" FontSize="11" Foreground="#9D174D" Margin="0,4"/>
                                        <TextBlock x:Name="txtBuzagiAdet" Text="0" FontSize="18" Foreground="#DB2777" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Grid.Row="1" Columns="2">
                                <Border Background="#FEF3C7" CornerRadius="15" Margin="4" Cursor="Hand" >
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Çıkanlar" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#92400E"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <md:PackIcon Kind="Logout" Foreground="#D97706" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtCikanAdet" Text="0" FontSize="18" Foreground="#D97706" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FEE2E2" CornerRadius="15" Margin="4" Cursor="Hand" >
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Silinenler" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#991B1B"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <md:PackIcon Kind="Delete" Foreground="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtSilinenAdet" Text="0" FontSize="18" Foreground="#EF4444" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>

               
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <TextBlock Text="Sağlık ve Üretim Durumu" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Columns="3">
                                <Border Background="#FFF1F2" CornerRadius="15" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="MedicalBag" HorizontalAlignment="Center" Width="20" Height="20" Foreground="#E11D48"/>
                                        <TextBlock Text="Hasta" HorizontalAlignment="Center" FontSize="11" Foreground="#9F1239"/>
                                        <TextBlock x:Name="txtHastaAdet" Text="0" FontSize="22" Foreground="#E11D48" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0F9FF" CornerRadius="15" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="WaterOpacity" HorizontalAlignment="Center" Width="20" Height="20" Foreground="#0284C7"/>
                                        <TextBlock Text="Sağmal" HorizontalAlignment="Center" FontSize="11" Foreground="#075985"/>
                                        <TextBlock x:Name="txtSagmalAdet" Text="0" FontSize="22" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" CornerRadius="15" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <md:PackIcon Kind="CalendarMonthOutline" HorizontalAlignment="Center" Width="20" Height="20" Foreground="#64748B"/>
                                        <TextBlock Text="Kuruda" HorizontalAlignment="Center" FontSize="11" Foreground="#334155"/>
                                        <TextBlock x:Name="txtKurudaAdet" Text="0" FontSize="22" Foreground="#64748B" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                                <Border Background="#F5F3FF" CornerRadius="15" Margin="4" Padding="5">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Taze" HorizontalAlignment="Center" FontSize="10" Foreground="#5B21B6"/>
                                        <TextBlock x:Name="txtTazeAdet" Text="0" FontSize="18" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#ECFDF5" CornerRadius="15" Margin="4" Padding="5">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Gebe" HorizontalAlignment="Center" FontSize="10" Foreground="#065F46"/>
                                        <TextBlock x:Name="txtGebeAdet" Text="0" FontSize="18" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF7ED" CornerRadius="15" Margin="4" Padding="5">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tohumlu" HorizontalAlignment="Center" FontSize="10" Foreground="#9A3412"/>
                                        <TextBlock x:Name="txtTohumluAdet" Text="0" FontSize="18" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FEF2F2" CornerRadius="15" Margin="4" Padding="5">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Boş" HorizontalAlignment="Center" FontSize="10" Foreground="#991B1B"/>
                                        <TextBlock x:Name="txtBosAdet" Text="0" FontSize="18" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>

              
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <TextBlock Text="Nakit Akış Analizi" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="3">
                            <Border Background="#F0FDF4" CornerRadius="15" Margin="5" Padding="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Gelir" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11" Foreground="#166534"/>
                                    <TextBlock x:Name="txtGelir" Text="0" FontSize="16" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <md:PackIcon Kind="ArrowUp" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="10">
                                <Ellipse Stroke="#16A34A" StrokeThickness="4" StrokeDashArray="4 1"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="%0" HorizontalAlignment="Center" Foreground="#16A34A" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Denge" HorizontalAlignment="Center" FontSize="9" Foreground="#64748B"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#FEF2F2" CornerRadius="15" Margin="5" Padding="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Gider" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11" Foreground="#991B1B"/>
                                    <TextBlock x:Name="txtGider" Text="0" FontSize="16" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <md:PackIcon Kind="ArrowDown" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

            
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <TextBlock Text="Süt Verimliliği (Litre)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="2">
                            <Border Background="#F8FAFC" CornerRadius="15" Margin="5" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <md:PackIcon Kind="ChartLine" Foreground="#64748B" HorizontalAlignment="Center" Width="24" Height="24"/>
                                    <TextBlock Text="Yıllık Ortalama" HorizontalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,4"/>
                                    <TextBlock x:Name="txtYillikSut" Text="0" FontSize="22" Foreground="#1E293B" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F0F9FF" CornerRadius="15" Margin="5" BorderBrush="#BAE6FD" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <md:PackIcon Kind="Water" Foreground="#0284C7" HorizontalAlignment="Center" Width="24" Height="24"/>
                                    <TextBlock Text="Toplam Üretim" HorizontalAlignment="Center" FontSize="11" Foreground="#075985" Margin="0,4"/>
                                    <TextBlock x:Name="txtToplamSut" Text="0" FontSize="22" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

              
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <TextBlock Text="Yem ve Rasyon Yönetimi" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="2">
                            <Button Style="{StaticResource ActionButton}" Background="#F1F5F9" >
                                <StackPanel>
                                    <md:PackIcon Kind="FoodApple" Foreground="#475569" HorizontalAlignment="Center" Width="28" Height="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Rasyon Hazırla" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                                    <TextBlock x:Name="txtRasyon" Text="0 Rasyon" FontSize="10" HorizontalAlignment="Center" Foreground="#0D9488"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Background="#ECFDF5" >
                                <StackPanel>
                                    <md:PackIcon Kind="Warehouse" Foreground="#059669" HorizontalAlignment="Center" Width="28" Height="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Stok Durumu" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#065F46"/>
                                    <TextBlock x:Name="txtStok" Text="0 Stok" FontSize="10" HorizontalAlignment="Center" Foreground="#0D9488"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource DashboardCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HeaderBar}">
                            <TextBlock Text="Aktif Görevler" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#37474F"/>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="2">
                            <Button Style="{StaticResource ActionButton}" Background="#F0FDFA" >
                                <StackPanel>
                                    <md:PackIcon Kind="CalendarClock" HorizontalAlignment="Center" Width="28" Height="28" Foreground="#0D9488" Margin="0,0,0,5"/>
                                    <TextBlock Text="Son Durumlar" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#115E59"/>
                                    <TextBlock x:Name="txtDurumBildirim" Text="0 Aktif İşlem" FontSize="10" HorizontalAlignment="Center" Foreground="#0D9488"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Background="#FFFBEB" >
                                <StackPanel>
                                    <md:PackIcon Kind="PlaylistCheck" HorizontalAlignment="Center" Width="28" Height="28" Foreground="#D97706" Margin="0,0,0,5"/>
                                    <TextBlock Text="Haftalık Görev" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock x:Name="txtGorevBildirim" Text="0 Bekleyen" FontSize="10" HorizontalAlignment="Center" Foreground="#D97706"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>